<h1>Booking Cancelled</h1>

<p>Hi <%= @host.name %>,</p>

<p>A booking has been cancelled:</p>

<table>
  <tr>
    <td><strong>Meeting:</strong></td>
    <td><%= @link.meeting_name %></td>
  </tr>
  <tr>
    <td><strong>Invitee:</strong></td>
    <td><%= @booking.invitee_name %> (<%= @booking.invitee_email %>)</td>
  </tr>
  <tr>
    <td><strong>Date:</strong></td>
    <td><%= @booking.start_time.in_time_zone(@timezone).strftime("%A, %B %-d, %Y") %></td>
  </tr>
  <tr>
    <td><strong>Time:</strong></td>
    <td>
      <%= @booking.start_time.in_time_zone(@timezone).strftime("%-I:%M %p") %> &ndash;
      <%= @booking.end_time.in_time_zone(@timezone).strftime("%-I:%M %p") %>
      (<%= @timezone.name %>)
    </td>
  </tr>
</table>
